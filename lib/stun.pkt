// STUN wire format (RFC 8489). Generates stun_wire_gen.h and stun_wire_gen.c
// with pktc, see lib/CMakeLists.txt. message.h builds on it, so nothing else
// uses the generated code.
protocol stun_wire;
endian big;

// Also the key for XOR-MAPPED-ADDRESS
const MAGIC_COOKIE: u32 = 0x2112A442;

// The length counts the attributes, not the 20-byte header.
message Message {
  zero: u2 = 0;
  // the type interleaves a 12-bit method and a 2-bit class
  method_high: u5;
  class_high: u1;
  method_mid: u3;
  class_low: u1;
  method_low: u4;
  length: u16;
  cookie: u32 = 0x2112A442;
  transaction_id: u8[12];
  attributes: Attribute[length];
}

// The length counts the value but not the padding.
struct Attribute {
  type: u16;
  length: u16;
  value: u8[length] pad 4;
}

enum Family : u8 {
  IPV4 = 0x01,
  IPV6 = 0x02,
}

// The value of XOR-MAPPED-ADDRESS. The port and address are
// XORed with the cookie, and an IPv6 address also with the transaction ID.
message XorMappedAddress {
  _: u8;
  family: Family;
  port: u16;
  address: switch (family) {
    IPV4 => Ipv4,
    IPV6 => Ipv6,
  };
}

struct Ipv4 {
  addr: u8[4];
}

struct Ipv6 {
  addr: u8[16];
}

// The value of ERROR-CODE. The code is class * 100 + number.
message ErrorCode {
  _: u21;
  class: u3;
  number: u8;
  reason: u8[..];
}
